+    process.env.ANTHROPIC_API_KEY = 'sk-test';
+    process.env.ANTHROPIC_BASE_URL = `http://127.0.0.1:${server.address().port}`;
+    // The provider caches its client; load a fresh copy so it picks up the mock URL.
