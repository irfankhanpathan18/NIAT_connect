# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ==========================================
# In Vercel Project Settings -> Environment Variables, add:
# VITE_API_BASE_URL=https://your-backend-host.onrender.com

VITE_API_BASE_URL=

# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Render/Railway Node Server)
# ==========================================
# PORT=5000
# JWT_SECRET=nxtwave_ambassador_crm_secret_key_2026
# CORS_ORIGIN=https://your-frontend.vercel.app
# FRONTEND_URL=https://your-frontend.vercel.app

PORT=5000
JWT_SECRET=nxtwave_ambassador_crm_secret_key_2026
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5173

# Optional: enables Gemini answers in the AI chatbot (falls back to verified article search without it)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Optional: use Claude for the AI agent instead of Gemini
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# Optional: force the agent provider (claude | gemini | offline)
# AGENT_PROVIDER=
# Optional: raises the GitHub API rate limit for the scholarship profile review
# GITHUB_TOKEN=
# Optional: pin the admission intake year used by lead scoring (defaults to the current cycle)
# ADMISSION_INTAKE_YEAR=
